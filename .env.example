# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# The form posts to /api/contact, which relays the message through Resend
# (resend.com). Create a free account and add an API key below. The inbox
# defaults to the email configured in src/data/site.ts; override it only if
# messages should go to a different address.
#
# Until these are set, the endpoint answers honestly — "The contact form is not
# available right now." — instead of showing a success message for a message it
# never sent.
#
# Server-side only. Nothing here carries the NEXT_PUBLIC_ prefix, so none of it
# can end up in the browser bundle.

# Resend API key (Dashboard -> API Keys).


# Optional inbox override. When omitted, messages go to siteConfig.email.


# Optional. The From address. `onboarding@resend.dev` is Resend's shared test
# sender and works without a verified domain, which is why it is the default;
# set a verified address on your own domain before relying on it.
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used by canonical URLs, Open Graph tags, the sitemap and
# robots.txt.
NEXT_PUBLIC_SITE_URL=https://yemisrach-zerfe.vercel.app
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_x8uuxi2
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_l0jhn22
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=-XLFJtsee10giO6ec