[TEMPLATE]
# Backend environment — copy these names into your host (Render, Railway, Fly,
# Docker) or into `server/.env` for a local run.
#
# EmailJS only: the same provider the site uses in the browser. The server needs
# the account's PRIVATE key, which must never be committed or shipped to the
# browser. Set these in the host's dashboard, not by uploading this file.
#
# No port is configured here on purpose: Render/Railway/Fly inject PORT and route
# to it, Docker sets API_PORT, and a local run defaults to 4000.

# EmailJS dashboard → Account → General: service id, template id, public key.
# These three are public (the site already ships them), but keep them together.
EMAILJS_SERVICE_ID=service_x8uuxi2
EMAILJS_TEMPLATE_ID=template_l0jhn22
EMAILJS_PUBLIC_KEY=-XLFJtsee10giO6ec

# EmailJS dashboard → Account → Security → API Keys: the private key.
# This is the secret. Without it POST /api/contact answers 503.
EMAILJS_PRIVATE_KEY=

# Where messages are delivered. Passed to the template as `to_email`.
CONTACT_TO_EMAIL=yemisrachzerfe021@gmail.com

# Origins allowed to call the API from a browser, comma-separated.
ALLOWED_ORIGINS=https://yemisrach-zerfe.vercel.app
