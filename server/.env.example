# Backend service (server/server.js)
#
# Copy to `server/.env` for local runs, or set these on the host.
# Nothing here is public: no NEXT_PUBLIC_ prefix, nothing reaches the browser.

# Port the API listens on. The Next app calls it at NEXT_PUBLIC_CONTACT_API_URL.
API_PORT=4000

# Resend API key (resend.com → Dashboard → API Keys). Without it the endpoint
# answers 503 instead of pretending a message was sent.
RESEND_API_KEY=

# Where messages go. Defaults to the address published on the site.
CONTACT_TO_EMAIL=

# From address. `onboarding@resend.dev` works without a verified domain; a
# verified address on your own domain should replace it in production.
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>

# Comma-separated origins allowed to call the API from a browser. Empty means
# any origin. Set this once the site has a permanent domain.
ALLOWED_ORIGINS=
